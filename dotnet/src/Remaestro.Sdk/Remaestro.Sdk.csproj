<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- See eng/Packaging.props for why the package id and the assembly name differ. -->
    <IsPackable>true</IsPackable>
    <PackageId>Remaestro.Plugins.Sdk</PackageId>
    <Description>
      Write a reMaestro plugin in C# without writing any gRPC. Implement IRemaestroDriver and
      IRemaestroDevice, call DriverHost.RunAsync, and this hosts the server, answers all eighteen RPCs,
      derives what your device supports from the interfaces it implements, and runs the event stream and
      heartbeat. DeviceBase and LineDevice absorb the connect/reconnect/frame/trace problem for TCP and
      serial gear. Every driver that ships with reMaestro is built on this.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serial is a first-class transport here: a lot of AV gear speaks the same protocol over RS-232 as
         over the network, and the drivers that need it were each opening their own port. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remaestro.Grpc\Remaestro.Grpc.csproj" />
  </ItemGroup>

</Project>
